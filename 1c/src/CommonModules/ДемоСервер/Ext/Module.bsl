// Служебные процедуры демо-стенда интеграции 1С -> Kafka -> PostgreSQL.
// Вызываются из модуля управляемого приложения по параметру запуска /C:
//   init         - настроить состав OData и заполнить тестовые данные
//   odata        - только настроить состав стандартного интерфейса OData
//   seed         - только заполнить тестовые данные (повторный вызов ничего не дублирует)
//   demo-update  - изменить контрагента ООО «Ромашка» (шаг демонстрации)
//   demo-delete  - пометить на удаление контрагента ООО «Лютик» (шаг демонстрации)
//   demo-restore - снять пометку удаления с ООО «Лютик»

Функция ВыполнитьКоманду(Знач Команда) Экспорт

	Команда = НРег(СокрЛП(Команда));

	Если Команда = "init" Тогда
		НастроитьOData();
		ЗаполнитьДемоДанные();
	ИначеЕсли Команда = "odata" Тогда
		НастроитьOData();
	ИначеЕсли Команда = "seed" Тогда
		ЗаполнитьДемоДанные();
	ИначеЕсли Команда = "demo-update" Тогда
		ИзменитьКонтрагента();
	ИначеЕсли Команда = "demo-delete" Тогда
		УстановитьПометкуКонтрагента("ООО «Лютик»", Истина);
	ИначеЕсли Команда = "demo-restore" Тогда
		УстановитьПометкуКонтрагента("ООО «Лютик»", Ложь);
	Иначе
		Возврат "Неизвестная команда: " + Команда;
	КонецЕсли;

	ЗаписьЖурналаРегистрации("ДемоИнтеграция", УровеньЖурналаРегистрации.Информация, , , "Выполнена команда " + Команда);
	Возврат "Выполнена команда " + Команда;

КонецФункции

Процедура НастроитьOData() Экспорт

	Состав = Новый Массив;
	Состав.Добавить(Метаданные.Справочники.ФормыСобственности);
	Состав.Добавить(Метаданные.Справочники.Контрагенты);
	УстановитьСоставСтандартногоИнтерфейсаOData(Состав);

КонецПроцедуры

Процедура ЗаполнитьДемоДанные() Экспорт

	ООО = ФормаСобственности("ООО");
	ИП  = ФормаСобственности("ИП");
	АО  = ФормаСобственности("АО");
	ПАО = ФормаСобственности("ПАО");

	Контрагент("ООО «Ромашка»",  "7701234567",   "770101001", ООО);
	Контрагент("ИП Иванов И.И.", "500100732259", "",          ИП);
	Контрагент("АО «Север»",     "7802345678",   "780201001", АО);
	Контрагент("ПАО «Восток»",   "2501234567",   "250101001", ПАО);
	Контрагент("ООО «Лютик»",    "7703456789",   "770301001", ООО);
	Контрагент("ИП Петрова А.С.", "771234567890", "",         ИП);

КонецПроцедуры

Функция ФормаСобственности(Наименование)

	Ссылка = Справочники.ФормыСобственности.НайтиПоНаименованию(Наименование, Истина);
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ссылка;
	КонецЕсли;

	Объект = Справочники.ФормыСобственности.СоздатьЭлемент();
	Объект.Наименование = Наименование;
	Объект.Записать();
	Возврат Объект.Ссылка;

КонецФункции

Процедура Контрагент(Наименование, ИНН, КПП, Форма)

	Если ЗначениеЗаполнено(Справочники.Контрагенты.НайтиПоНаименованию(Наименование, Истина)) Тогда
		Возврат;
	КонецЕсли;

	Объект = Справочники.Контрагенты.СоздатьЭлемент();
	Объект.Наименование = Наименование;
	Объект.ИНН = ИНН;
	Объект.КПП = КПП;
	Объект.ФормаСобственности = Форма;
	Объект.Записать();

КонецПроцедуры

Процедура ИзменитьКонтрагента()

	Ссылка = Справочники.Контрагенты.НайтиПоНаименованию("ООО «Ромашка»", Истина);
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		ВызватьИсключение "Не найден контрагент ООО «Ромашка»";
	КонецЕсли;

	Объект = Ссылка.ПолучитьОбъект();
	// Меняем КПП: наименование оставляем, чтобы шаг можно было повторять
	Объект.КПП = ?(Объект.КПП = "770101001", "770101002", "770101001");
	Объект.Записать();

КонецПроцедуры

Процедура УстановитьПометкуКонтрагента(Наименование, Пометка)

	Ссылка = Справочники.Контрагенты.НайтиПоНаименованию(Наименование, Истина);
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		ВызватьИсключение "Не найден контрагент " + Наименование;
	КонецЕсли;

	Ссылка.ПолучитьОбъект().УстановитьПометкуУдаления(Пометка);

КонецПроцедуры
