# Скопируйте в .env и при необходимости поменяйте значения: cp .env.example .env

# --- 1С (OData) ---------------------------------------------------------------
# Реальная 1С, опубликованная на веб-сервере хост-машины (см. 1c/setup.md):
ONEC_ODATA_URL=http://host.docker.internal/demo1c/odata/standard.odata
# Если в информационной базе есть пользователи — логин/пароль для Basic-авторизации OData
ONEC_USER=
ONEC_PASSWORD=
ONEC_PAGE_SIZE=500

# Вариант без веб-сервера 1С — эмулятор OData:
# COMPOSE_PROFILES=mock
# ONEC_ODATA_URL=http://onec-mock:8080/demo1c/odata/standard.odata

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_DB=integration
POSTGRES_USER=integration
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# --- Kafka --------------------------------------------------------------------
KAFKA_EXTERNAL_PORT=9094
KAFKA_UI_PORT=8090
KAFKA_GROUP_ID=pg-sink

# --- Синхронизация ------------------------------------------------------------
# 0 — только ручной запуск; >0 — integration-service сам делает инкрементальную синхронизацию с этим интервалом
SYNC_INTERVAL_SECONDS=0
# Перекрытие окна инкрементальной выгрузки (сек.), дубли безопасны
SYNC_OVERLAP_SECONDS=5
RETRY_MAX_ATTEMPTS=5
LOG_LEVEL=INFO

INTEGRATION_HEALTH_PORT=8081
CONSUMER_HEALTH_PORT=8082
ONEC_MOCK_PORT=8085
